{
  "name": "future-of-music-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-gallery.mjs && next build --webpack",
    "build:sites": "pnpm run build && node scripts/prepare-sites-static.mjs",
    "start": "next start",
    "test": "pnpm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/grant-tracker.test.mjs tests/grant-database.test.mjs tests/finance.test.mjs tests/finance-database.test.mjs tests/receipt.test.mjs",
    "test:grants": "node --experimental-strip-types --test tests/grant-tracker.test.mjs tests/grant-database.test.mjs tests/finance.test.mjs tests/finance-database.test.mjs tests/receipt.test.mjs",
    "typecheck:grants": "tsc --project tsconfig.grants.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
